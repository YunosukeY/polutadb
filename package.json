{
  "name": "poluta-db",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --passWithNoTests",
    "test:data": "jest --testPathIgnorePatterns /node_modules/ --runTestsByPath src/data/data.test.ts",
    "e2e": "playwright test",
    "e2e:dev": "E2E_TARGET=dev playwright test",
    "vrt": "e2e/vrt/docker.sh",
    "vrt:update": "e2e/vrt/docker.sh --update-snapshots",
    "tsc": "tsc -p tsconfig.jsonc",
    "biome": "biome check src e2e playwright.config.ts",
    "biome:write": "biome check --write src e2e playwright.config.ts"
  },
  "dependencies": {
    "@amcharts/amcharts5": "5.23.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "6.5.0",
    "@mui/material": "6.5.0",
    "jotai": "3.0.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-share": "5.3.0",
    "react-slick": "0.31.0",
    "react-use": "17.6.1",
    "slick-carousel": "1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/gtag.js": "0.0.20",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-slick": "0.23.13",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
