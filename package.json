{
  "name": "poluta-db",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest --passWithNoTests",
    "test:data": "jest --testPathIgnorePatterns /node_modules/ --runTestsByPath src/data/data.test.ts",
    "e2e": "playwright test",
    "e2e:dev": "E2E_TARGET=dev playwright test",
    "vrt": "e2e/vrt/docker.sh",
    "vrt:update": "e2e/vrt/docker.sh --update-snapshots",
    "tsc": "tsc -p tsconfig.jsonc",
    "biome": "biome check src e2e playwright.config.ts",
    "biome:write": "biome check --write src e2e playwright.config.ts"
  },
  "dependencies": {
    "@amcharts/amcharts5": "5.8.0",
    "@emotion/react": "11.10.5",
    "@emotion/styled": "11.10.5",
    "@mui/icons-material": "5.11.0",
    "@mui/material": "5.12.1",
    "next": "14.0.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-share": "5.1.0",
    "react-slick": "0.30.1",
    "react-use": "17.5.0",
    "recoil": "0.7.6",
    "slick-carousel": "1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/gtag.js": "0.0.12",
    "@types/jest": "29.5.0",
    "@types/node": "24.19.1",
    "@types/react": "18.2.6",
    "@types/react-slick": "0.23.4",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-node": "10.9.1",
    "typescript": "5.7.2"
  },
  "overrides": {
    "@types/react": "18.2.6"
  }
}
